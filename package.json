{
  "name": "envhelper",
  "version": "0.2.0",
  "description": "Local-first .env setup and encrypted sharing for small teams.",
  "type": "module",
  "bin": {
    "envhelper": "./src/cli.js"
  },
  "files": [
    "src",
    "providers",
    "README.md",
    "SECURITY.md",
    "THREAT_MODEL.md",
    "CONTRIBUTING.md",
    "LICENSE"
  ],
  "scripts": {
